# ============================================================
# Unreal Engine
# ============================================================

# Unreal generated binaries
Binaries/
Plugins/**/Binaries/

# Unreal intermediate build files
Intermediate/
Plugins/**/Intermediate/

# Editor/runtime generated files
Saved/

# Derived Data Cache
DerivedDataCache/

# Per-developer Unreal content
Content/Developers/

# Built data for maps
*_BuiltData.uasset


# ============================================================
# IDE / Editor Files
# ============================================================

# Visual Studio
.vs/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Rider / JetBrains
.idea/
*.sln.DotSettings.user
*.DotSettings.user

# VS Code
.vscode/

# Xcode
*.xcodeproj
*.xcworkspace


# ============================================================
# Compiler / Build Artifacts
# ============================================================

# Compiled object files
*.slo
*.lo
*.o
*.obj

# Precompiled headers
*.gch
*.pch

# Debug / compiler database files
*.pdb
*.ipch
*.iobj
*.ipdb

# Fortran module files
*.mod

# Compiler / linker temporary files
*.ilk
*.exp
*.idb


# ============================================================
# Executables / Generated Applications
# ============================================================

*.exe
*.out
*.app
*.ipa


# ============================================================
# Unreal Build Directory
# ============================================================

# Most Build content is generated, but some platform-specific
# resources may need to be committed.
Build/*

# Allow Build subdirectories to be traversed
!Build/*/

# Keep Pak blacklist files
!Build/**/PakBlacklist*.txt

# Keep icon files
!Build/**/*.ico


# ============================================================
# Source Art
# ============================================================

# Precompiled/source-art image files not intended for the game
SourceArt/**/*.png
SourceArt/**/*.tga


# ============================================================
# Logs / Temporary Files
# ============================================================

*.log
*.tmp
*.temp
*.bak
*.old
*.dmp


# ============================================================
# Operating System Files
# ============================================================

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride

# macOS resource forks
._*


# ============================================================
# Miscellaneous
# ============================================================

# Windows shortcuts
*.lnk

# Vim swap files
*.swp
*.swo

# Temporary editor files
*~